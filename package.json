{
  "name": "clauseguard-app",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "node server/index.js",
    "build": "vite build",
    "preview": "concurrently -k \"npm:dev:api\" \"vite preview --host 0.0.0.0 --port 3000\"",
    "start": "npm run preview",
    "test": "node --test server/lib/analyze.test.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.544.0",
    "mammoth": "^1.9.1",
    "multer": "^2.0.2",
    "pdfjs-dist": "4.10.38",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.1.13",
    "vite": "^7.1.5"
  }
}
